# Copy this file to `.env` and fill in your project's values.
# Supabase is optional: without these the app runs fully offline.
# NOTE: `.env` is bundled into the app as an asset at build time, so a missing
# `.env` fails the build on purpose - it prevents shipping an app whose auth
# silently never works (the "authUnavailable" signup trap).
#
# Get them from: Supabase Dashboard > Project Settings > API Keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_anon_key
