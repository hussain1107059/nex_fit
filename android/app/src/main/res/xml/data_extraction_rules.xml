<?xml version="1.0" encoding="utf-8"?>
<!-- Data-extraction rules for Android 12+. NexFit holds sensitive local data
     (unencrypted SQFlite fitness records, PIN hashes, session tokens) and
     explicitly excludes everything from device-to-device migration and
     cloud backup. On-device transfers are also excluded: restoring onto a
     second device would leak the app-lock PIN and session. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="sharedpref"
            path="." />
        <exclude
            domain="root"
            path="." />
        <exclude
            domain="file"
            path="." />
        <exclude
            domain="external"
            path="." />
        <exclude
            domain="device_encrypted"
            path="." />
        <exclude
            domain="device_protected"
            path="." />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="sharedpref"
            path="." />
        <exclude
            domain="root"
            path="." />
        <exclude
            domain="file"
            path="." />
        <exclude
            domain="external"
            path="." />
        <exclude
            domain="device_encrypted"
            path="." />
        <exclude
            domain="device_protected"
            path="." />
    </device-transfer>
</data-extraction-rules>